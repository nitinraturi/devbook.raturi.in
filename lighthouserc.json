{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "Serving dist",
      "url": [
        "http://127.0.0.1:4324/",
        "http://127.0.0.1:4324/start-here/setup/",
        "http://127.0.0.1:4324/instructions/security/",
        "http://127.0.0.1:4324/stacks/astro/"
      ],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 } }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}

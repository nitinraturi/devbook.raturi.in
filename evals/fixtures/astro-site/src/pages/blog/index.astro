---
import Base from '../../layouts/Base.astro';
import { posts } from '../../lib/posts.js';
import { formatDate } from '../../lib/format.js';
---

<Base title="Blog" description="Product notes and essays on thinking with notes, from the team that builds Lumen.">
	<h1>Blog</h1>
	<ul>
		{posts.map((post) => (
			<li>
				<a href={`/blog/${post.slug}/`}>{post.title}</a> <time datetime={post.date}>{formatDate(post.date)}</time>
			</li>
		))}
	</ul>
</Base>

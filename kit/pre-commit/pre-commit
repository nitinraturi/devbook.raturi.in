#!/bin/sh
# Git pre-commit hook: scans staged changes for secrets with gitleaks before each commit.
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed, so staged changes were not scanned for secrets." >&2
	echo "Install it (https://github.com/gitleaks/gitleaks#installing), then commit again." >&2
	exit 1
fi
exec gitleaks git --pre-commit --redact --staged --verbose

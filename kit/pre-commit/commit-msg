#!/bin/sh
# Git commit-msg hook: the subject must follow Conventional Commits, such as "fix(api): reject expired tokens".
subject=$(grep -v '^#' "$1" | grep -m1 .)
case "$subject" in
	Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'; then
	echo "commit-msg: \"$subject\" is not a Conventional Commits subject." >&2
	echo "Use type(scope): summary, for example \"fix(api): reject expired tokens\". Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test." >&2
	exit 1
fi

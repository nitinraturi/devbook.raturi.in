---
// Page banner from the `banner` frontmatter, with a dismiss button that src/scripts/site.ts remembers per visitor.
// Used for the old-install warning on the homepage and setup page.
const { banner } = Astro.locals.starlightRoute.entry.data;
---

{banner && (
	<div class="dvb-banner" data-pagefind-ignore data-banner>
		<p set:html={banner.content} />
		<button type="button" data-banner-dismiss aria-label="Dismiss this notice">
			<svg
				aria-hidden="true"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<path d="M6 6l12 12M18 6 6 18" />
			</svg>
		</button>
	</div>
)}

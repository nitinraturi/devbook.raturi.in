---
// The newest committed measured eval (evals/results/*.json via src/lib/evals.ts): one row per case with the
// with-Devbook score, the no-Devbook score and Δ. Before the first measured run it says so instead.
import { delta, latest, score } from '../lib/evals';

interface Props {
	suite: string;
}

const { suite } = Astro.props;
const result = latest()?.suites[suite];
---

{result ? (
	<table>
		<thead>
			<tr>
				<th scope="col">Case</th>
				<th scope="col">With Devbook</th>
				<th scope="col">Without</th>
				<th scope="col">Δ</th>
			</tr>
		</thead>
		<tbody>
			{result.cases.map((c) => (
				<tr>
					<td>
						<code>{c.name}</code>
					</td>
					<td>{score(c.with)}</td>
					<td>{score(c.without)}</td>
					<td>{delta(c.delta)}</td>
				</tr>
			))}
		</tbody>
	</table>
) : (
	<p>No measured results yet.</p>
)}

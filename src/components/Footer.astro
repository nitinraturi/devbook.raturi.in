---
import Default from '@astrojs/starlight/components/Footer.astro';
import { GA_ID, PERSON } from '../lib/site';
---

<Default />
<div class="dvb-site-footer">
	<span>
		Written by{' '}
		<a href={PERSON.url} rel="author">
			{PERSON.name}
		</a>{' '}
		· Built in the open since October 2026
	</span>
	<nav aria-label="Site">
		<a href="/about/">About</a>
		<a href="/start-here/writing-instructions/">Writing instructions</a>
		<a href="/start-here/contact/">Contact</a>
		<a href="/license/">License</a>
		<a href="/privacy/">Privacy</a>
		{GA_ID && (
			<button type="button" data-consent-open>
				Cookie settings
			</button>
		)}
	</nav>
</div>
{GA_ID && (
	<div class="dvb-consent" role="region" aria-label="Analytics consent" data-consent hidden>
		<p>
			May this site use Google Analytics cookies to count visits? No advertising, no personal data.
			<a href="/privacy/">Privacy notice</a>.
		</p>
		<div class="dvb-consent-actions">
			<button type="button" data-consent-choice="granted">
				Accept analytics
			</button>
			<button type="button" data-consent-choice="denied">
				Decline
			</button>
		</div>
	</div>
)}

<script>
	import '../scripts/site';
</script>

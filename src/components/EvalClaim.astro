---
// The homepage's one-sentence result, from the committed evals (src/lib/evals.ts), so the claim can't drift from them.
import { latestResults, pct, taskCount, tokens } from '../lib/evals';

const results = latestResults();
const v1 =
	results.find((r) => r.variant === 'local') ??
	results.find((r) => r.variant === 'stable') ??
	results.find((r) => r.variant === 'main');
const before = results.find((r) => r.variant === 'ref:9504d10');
---

{v1 && before && (
	<p class="dvb-home-claim">
		In modelled evals on {taskCount()} tasks, Devbook puts the rules each task needs in front of the assistant in{' '}
		{pct(v1.overall.passRate)} of tasks, using {tokens(v1.overall.meanInputTokens)} tokens per task, against{' '}
		{pct(before.overall.passRate)} at {tokens(before.overall.meanInputTokens)} tokens before the prune.{' '}
		<a href="/evals/">What was measured, and what wasn't</a>
	</p>
)}

// Cloudflare Workers with static assets only (no Worker script). See ADR-0002 and DEPLOY.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "devbook-raturi-in",
	"compatibility_date": "2026-10-22",
	// Build fresh on every `wrangler deploy` (local or Workers Builds) so a deploy never
	// ships a stale dist/. build:prod enables production-only features (analytics).
	"build": {
		"command": "npm run build:prod"
	},
	"assets": {
		"directory": "./dist",
		// /page → /page/ (matches trailingSlash: 'always'); /page/ serves page/index.html.
		"html_handling": "auto-trailing-slash",
		// Unknown paths get dist/404.html with a 404 status.
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "devbook.raturi.in", "custom_domain": true }],
	"workers_dev": true,
	"observability": { "enabled": false }
}
